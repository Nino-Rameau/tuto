generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Utilisateur {
  id         Int           @id @default(autoincrement())
  email      String        @unique @db.VarChar(255)
  password   String        @db.VarChar(255)
  profil     Profil        @default(user)
  created_at DateTime      @default(now()) @db.Timestamp(0)
  updated_at DateTime      @default(now()) @updatedAt @db.Timestamp(0)
  
  progressions Progression[]

  @@map("utilisateur")
}

model Tuto {
  id              Int              @id @default(autoincrement())
  titre           String           @unique @db.VarChar(100)
  slug            String           @unique @db.VarChar(100)
  pre_requis      String?          @db.Text
  chapo           String           @db.LongText
  intro           String           @db.LongText
  contenu         String           @db.LongText
  MetaTitle       String?          @db.VarChar(70)
  MetaDescription String?          @db.VarChar(190)
  image           String           @db.VarChar(255)
  statut          StatutTuto       @default(brouillon)
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  updated_at      DateTime         @default(now()) @updatedAt @db.Timestamp(0)

  progressions    Progression[]
  tuto_categories TutoCategorie[]

  @@map("tuto")
}

model Progression {
  id         Int              @id @default(autoincrement())
  user_id    Int
  tuto_id    Int
  etat       EtatProgression?
  created_at DateTime         @default(now()) @db.Timestamp(0)
  updated_at DateTime         @default(now()) @updatedAt @db.Timestamp(0)

  utilisateur Utilisateur @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tuto        Tuto        @relation(fields: [tuto_id], references: [id], onDelete: Cascade)

  @@unique([user_id, tuto_id])
  @@map("progression")
}

model Categorie {
  id              Int             @id @default(autoincrement())
  nom             String          @unique @db.VarChar(50)
  tuto_categories TutoCategorie[]

  @@map("categorie")
}

model TutoCategorie {
  categorie_id Int
  tuto_id      Int

  categorie Categorie @relation(fields: [categorie_id], references: [id], onDelete: Cascade)
  tuto      Tuto      @relation(fields: [tuto_id], references: [id], onDelete: Cascade)

  @@id([categorie_id, tuto_id])
  @@map("tuto_categorie")
}

// ENUMS (Strictement tes valeurs)
enum Profil {
  user
  admin
}

enum StatutTuto {
  brouillon
  en_ligne
}

enum EtatProgression {
  en_cours
  termine @map("terminé")
}